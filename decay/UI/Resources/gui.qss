QFrame#left {
        background-color: #d1cfd0;
}

QLabel {
        font-size: 10pt;
        font-family: 'SourceSansPro-Regular';
        color: #111111;
}


QPushButton {
        background-color: #c8c6bf;
        color: #000000; 
}

QComboBox {
        background-color: #ffc600;
        color: #000000;
}

QDoubleSpinBox {
        font-size: 10pt;
        background-color: #ffffff;
        color: #111111;
}

QDoubleSpinBox#readonly {
        font-size: 10pt;
        background-color: #e2eaf2;
        color: #111111;
}

QLabel#title {
        font-size: 16pt;
        font-family: 'SourceSansPro-Regular';
        color: #464244;
}


QLineEdit#readout {
        background-color: #f7f3c6;
        font-size: 10pt;
        /*background-color: #fff4ae; 
        font-family: 'SourceSansPro-Regular';
        background-color: #fff8b6;
        font-weight: bold; */
}

QLineEdit#input {
        background-color: #ffffff;
        font-size: 14pt;
        font-family: 'SourceSansPro-Regular';
        font-weight: bold;
}

